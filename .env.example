# Copia este archivo a ".env" (sin ".example") y rellena tus valores reales.
# El archivo ".env" NUNCA debe subirse a git (ver .gitignore en esta misma
# carpeta) porque aquí van tus contraseñas y llaves reales.

# Contraseña del usuario root de MySQL dentro del contenedor.
DB_PASSWORD=pon_aqui_una_contraseña_fuerte

# Nombre de la base de datos (debe coincidir con el nombre que usa tu dump
# en mysql-init/ y con el que ya usa tu aplicación).
DB_NAME=blautech_bd

# Secreto para firmar los JWT. Genera uno largo y aleatorio, por ejemplo
# con: openssl rand -base64 48
JWT_SECRET=pon_aqui_un_secreto_largo_y_aleatorio

# Dirección(es) desde donde se puede acceder al frontend en el navegador,
# separadas por coma si hay más de una. Con el reverse proxy de Nginx esto
# ya casi no se usa, pero lo dejamos configurado por si accedes directo al
# backend en algún momento. Ejemplo con dominio: https://blautech.midominio.com
CORS_ALLOWED_ORIGINS=http://localhost

# Opcional: tu API key de Google Gemini (https://aistudio.google.com/apikey).
# Si la dejas vacía, el análisis de coincidencia de habilidades sigue
# funcionando con el motor de reglas como respaldo.
GEMINI_API_KEY=
GEMINI_API_HABILITADO=true
